 	:
 	: "r" (state)
 	: "cc", "memory");
@@ -2074,6 +2076,7 @@ static void secdbg_fpsimd_save_state(struct user_fpsimd_state *state)
 static void secdbg_fpsimd_load_state(struct user_fpsimd_state *state)
