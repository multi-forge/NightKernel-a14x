 	"	ldp	q4, q5, [%0, #16 * 4]	\n"
@@ -2090,6 +2093,7 @@ static void secdbg_fpsimd_load_state(struct user_fpsimd_state *state)
 	"	ldp	q26, q27, [%0, #16 * 26]\n"
 	"	ldp	q28, q29, [%0, #16 * 28]\n"
 	"	ldp	q30, q31, [%0, #16 * 30]\n"
+\t"	.arch armv8-a\n"
 	:
 	: "r" (state)
 	: "cc", "memory");
