 	"	stp	q4, q5, [%0, #16 * 4]	\n"
@@ -2066,6 +2067,7 @@ static void secdbg_fpsimd_save_state(struct user_fpsimd_state *state)
 	"	stp	q26, q27, [%0, #16 * 26]\n"
